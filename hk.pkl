// Install with `hk install --mise` to ensure local tools are available
// Skip with `HK=0` or `git ... --no-verify`

amends "package://github.com/jdx/hk/releases/download/v1.53.0/hk@1.53.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v1.53.0/hk@1.53.0#/Builtins.pkl"

min_hk_version = "1.53.0"

local linters = new Mapping<String, Step> {
    ["actionlint"] = Builtins.actionlint
    ["go-test"] {
        glob = List("**/*.go")
        check = "go test ./..."
    }
    ["golangci-lint"] {
        glob = List("**/*.go")
        check = "golangci-lint run"
        fix = "golangci-lint run --fix"
    }
    ["pkl"] = Builtins.pkl
    // Matches the tombi LSP that formats TOML on save in nvim
    ["tombi-format"] = Builtins.tombi_format
}

local commit_msg_checks = new Mapping<String, Step> {
    ["commitizen"] {
        check = "cz check --allow-abort --commit-msg-file={{commit_msg_file}}"
    }
}

local pre_push_checks = new Mapping<String, Step> {
    ["commitizen-branch"] {
        // cz exits non-zero on an empty rev-range, which is the normal state of a
        // branch that is level with origin, so skip it rather than fail the hook
        check = #"test -z "$(git rev-list origin/HEAD..HEAD)" || cz check --rev-range origin/HEAD..HEAD"#
    }
}

hooks = new {
    ["pre-commit"] {
        fix = true
        stash = "patch-file"
        steps = linters
    }
    ["pre-push"] {
        steps = new {
            ...pre_push_checks
            ...linters
        }
    }
    ["commit-msg"] {
        steps = commit_msg_checks
    }
    ["fix"] {
        fix = true
        steps = linters
    }
    ["check"] {
        steps = new {
            ...pre_push_checks
            ...linters
        }
    }
}
